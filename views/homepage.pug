doctype html
html
  head
    title= title
    link(rel='stylesheet', href='/css/style.css')
  body
    h1= title
    a(href='/update-cobj') Add to this table
    table(border='1')
      tr
        th Name
        th Favorite Color
        th Bio
      each contact in contacts
        tr
          td= contact.properties.full_name
          td= contact.properties.favorite_color
          td= contact.properties.bio